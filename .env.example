# Convex / Nuxt playground
#
# Created by `npx convex dev` (from playground/):
#   CONVEX_DEPLOYMENT=...
#   NUXT_PUBLIC_CONVEX_URL=https://….convex.cloud
#
# Or set the URL manually:
NUXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# After `npx @convex-dev/auth` (or manual key gen), Convex dashboard also needs:
#   JWT_PRIVATE_KEY=...
#   JWKS=...
# SITE_URL is optional for password-only auth; useful if you add OAuth later:
#   SITE_URL=http://localhost:3000
