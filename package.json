{
  "name": "use-convex",
  "version": "0.0.2",
  "description": "First-class Convex integration for Nuxt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrmybtlr/convex-nuxt.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime/*": "./dist/runtime/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "dev": "nuxi dev playground --dotenv .env.local",
    "dev:backend": "cd playground && convex dev",
    "build:playground": "nuxi build playground",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:playground": "nuxi typecheck playground",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:e2e": "E2E_CONVEX=1 vp test playground/e2e test/e2e",
    "release": "semantic-release"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "h3": "^1.15.0"
  },
  "devDependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "^0.0.95",
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "^4.0.0",
    "@nuxt/test-utils": "^3.23.0",
    "@types/node": "^26.5.0",
    "convex": "^1.45.0",
    "convex-test": "^0.0.56",
    "happy-dom": "^20.14.0",
    "nitropack": "^2.13.0",
    "nuxt": "^4.5.2",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "peerDependencies": {
    "convex": "^1.21.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
      "vitest": "4.1.11"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "vitest": "4"
      }
    }
  }
}
